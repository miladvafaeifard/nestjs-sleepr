@PORT = 3001

@Email = user_2222@example.com
@Password = passWord@2222!

### Create a User
POST http://localhost:{{PORT}}/users
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}


### Post Login
POST http://localhost:{{PORT}}/auth/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}
